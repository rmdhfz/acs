# Salin ke .env (atau inject langsung sebagai environment variable di deployment).
# Jangan commit file .env asli.

# DSN sqlx/go-sql-driver/mysql, format: user:pass@tcp(host:port)/dbname?parseTime=true&loc=Local
ACS_DB_DSN=acs:acs@tcp(127.0.0.1:3306)/acs?parseTime=true&loc=Local&charset=utf8mb4

# Alamat listen REST API internal (Echo)
ACS_HTTP_ADDR=:8080

# Alamat listen endpoint CWMP (dipisah dari REST agar bisa di-expose/di-rate-limit berbeda)
ACS_CWMP_ADDR=:7547

# Secret untuk signing JWT sesi user (>= 32 karakter)
ACS_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
ACS_JWT_EXPIRY=8h

# Key AES-256 (32 byte, base64) untuk enkripsi kredensial connection request / inform auth.
# Generate mis. dengan: openssl rand -base64 32
ACS_CREDENTIAL_ENC_KEY=CHANGE_ME_BASE64_32_BYTE_KEY================

# Ukuran connection pool MariaDB (acsd). Bawaan sama seperti sebelum variabel ini
# ada (50/10/30 menit) — load test 2026-10-18 menemukan throughput CWMP plateau
# ~450-480 sesi/dtk krn 50 koneksi jadi bottleneck sebelum CPU acsd/MariaDB jenuh
# (docs/laporan/PROGRESS.md LANJUTAN 14). Naikkan di produksi/HA bila perlu,
# idle tidak boleh melebihi open.
ACS_DB_MAX_OPEN_CONNS=50
ACS_DB_MAX_IDLE_CONNS=10
ACS_DB_CONN_MAX_LIFETIME_MINUTES=30
# Batas MINIMUM diam (menit) sebelum perangkat dianggap offline. Batas sebenarnya per perangkat = max(ini, 2,5 x interval Periodic Inform yang dilaporkannya), maks 7 hari.
ACS_OFFLINE_MIN_MINUTES=15
# Selang polling OLT berkala (menit; 0 = nonaktif, bawaan). Memperbarui antrean ONU baru dan inventaris ONU terdaftar (status/port) tanpa menekan Poll manual.
ACS_OLT_POLL_MINUTES=0

# Berapa lama HTTP request CWMP dianggap idle/selesai menunggu request lanjutan dari CPE
ACS_SESSION_IDLE_TIMEOUT=30s

# Object storage firmware, S3-compatible (ROADMAP.md Fase 2 — MinIO untuk dev).
# Endpoint & kredensial WAJIB diisi eksplisit, tidak ada default hardcoded.
# Strategi delivery ke CPE: presigned GET URL LANGSUNG dari object storage ini
# (bukan proxy lewat ACS) — endpoint harus reachable dari jaringan CPE fisik
# di deployment nyata, bukan cuma dari ACS/dashboard.
ACS_MINIO_ENDPOINT=127.0.0.1:19000
ACS_MINIO_ACCESS_KEY=change-me-minio-access-key
ACS_MINIO_SECRET_KEY=change-me-minio-secret-key-min-8-char
ACS_MINIO_BUCKET=acs-firmware
ACS_MINIO_USE_SSL=false

# Email untuk reset password & notifikasi keamanan (akun terkunci, password
# diganti, akun baru). Kosongkan ACS_SMTP_HOST untuk menonaktifkan.
# Gmail: aktifkan 2-Step Verification lalu buat "App Password" 16 karakter
# (JANGAN pakai password akun Google). Port 587 = STARTTLS, 465 = TLS implisit.
# Isi kredensial asli hanya di .env lokal / secret manager — bukan di file ini.
ACS_SMTP_HOST=smtp.gmail.com
ACS_SMTP_PORT=587
ACS_SMTP_USERNAME=you@example.com
ACS_SMTP_PASSWORD=change-me-app-password
ACS_SMTP_FROM=you@example.com
ACS_SMTP_FROM_NAME=ACS Console
# Origin frontend untuk tautan di email (tanpa slash akhir).
ACS_PUBLIC_URL=http://localhost:5173
# Origin Console web yang boleh memanggil REST API (pisahkan dengan koma, tanpa slash akhir).
# Isi dengan alamat Console yang dibuka pengguna, mis. http://10.0.0.5:5173.
ACS_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Password Redis (opsional; kosong = tanpa auth — hanya untuk jaringan tertutup).
ACS_REDIS_PASSWORD=
# IP/CIDR reverse proxy tepercaya, pisahkan koma (mis. 10.0.0.5,10.1.0.0/24). Isi bila ACS di
# belakang proxy/LB; kosong = IP klien diambil dari socket dan X-Forwarded-For diabaikan.
ACS_TRUSTED_PROXIES=
# Rentang IP (CIDR, pisahkan koma) yang boleh menjadi host ConnectionRequestURL walau bukan IP sumber Inform. Isi bila ACS
# di balik NAT/port-forward/Docker Desktop (IP sumber CPE tersamar), mis. 10.0.0.0/8. Kosong = ketat (anti-SSRF penuh).
ACS_CR_TRUSTED_CIDRS=
# SaaS publik (admin tenant tidak tepercaya): true = tolak target webhook di jaringan privat (RFC1918/ULA/CGNAT), termasuk saat
# menyambung (menutup DNS rebinding). Biarkan false bila receiver webhook ada di LAN yang sama (mis. UAT/enterprise).
ACS_WEBHOOK_BLOCK_PRIVATE=false
# Host yang boleh menjadi URL task Download/Upload buatan API, pisahkan koma: nama host (files.example.com), subdomain
# (*.example.com; tidak mencakup example.com sendiri), IP (10.0.0.5), atau CIDR (10.0.0.0/24). Port diabaikan. Kosong = tidak
# dibatasi. Unduhan dari katalog firmware/berkas ACS (URL presigned) tidak terkena. Entri tidak valid = acsd gagal start.
ACS_TRANSFER_ALLOWED_HOSTS=
# Alert Prometheus -> Alertmanager -> notifikasi PLATFORM_ALERT untuk SUPERADMIN. Token Bearer untuk webhook Alertmanager -> acsd
# (acsd dan service alertmanager di docker-compose.yml memakai nilai yang sama), minimal 24 karakter acak, tanpa spasi, bukan
# placeholder. Kosong = endpoint tidak dipasang dan alert tidak diteruskan. Buat: openssl rand -hex 32
ACS_ALERTMANAGER_WEBHOOK_TOKEN=
# OLT Controller: true = daftarkan driver simulator (ONU palsu, tanpa koneksi jaringan) untuk pengembangan/e2e/demo. Jangan true di produksi.
ACS_OLT_SIM_ENABLED=false
# Endpoint /usp (TR-369) kerangka TANPA autentikasi: biarkan false di UAT/produksi.
ACS_USP_ENABLED=false
# Retensi tabel log (event, sesi CWMP, metrik optik, riwayat webhook) dalam hari; 0 = nonaktif, minimal 7.
ACS_LOG_RETENTION_DAYS=90
# Polling redaman optik (menit; 0 = nonaktif, minimal 15). Hanya vendor/model bermapping optical.* di katalog.
ACS_OPTICAL_POLL_MINUTES=360
# Penyegaran username PPPoE per perangkat (menit; 0 = nonaktif, minimal 60).
ACS_PPPOE_POLL_MINUTES=1440
ACS_PASSWORD_RESET_TTL=30m

# Masuk dengan Google (OpenID Connect) — lihat RUNBOOK §R. Kosongkan ACS_OIDC_ISSUER untuk menonaktifkan.
# Buat OAuth client (Web application) di Google Cloud Console; redirect URI HARUS sama persis dengan
# ACS_OIDC_REDIRECT_URL. Client secret hanya di .env lokal / secret manager.
ACS_OIDC_ISSUER=
ACS_OIDC_CLIENT_ID=
ACS_OIDC_CLIENT_SECRET=
ACS_OIDC_REDIRECT_URL=http://localhost:18080/api/v1/auth/oidc/callback
# Opsional: batasi SSO ke domain email tertentu (pisahkan koma), mis. perusahaan.co.id,anak.co.id
ACS_OIDC_ALLOWED_DOMAINS=

# Notifikasi proaktif (in-app + email): ambang evaluator 5 menit.
ACS_NOTIFY_OFFLINE_RATIO=0.30
ACS_NOTIFY_FAILED_TASKS=5

# Penerima email laporan bug dari Console. Bawaan: operator platform. Kosongkan nilainya untuk mematikan email (laporan tetap tersimpan di database).
ACS_BUG_REPORT_EMAIL=hfzrmd@gmail.com

# Langganan SaaS via Xendit (bawaan MATI). Bila true, secret key & callback token WAJIB (token >= 24 karakter acak).
# Daftarkan callback invoice di dashboard Xendit ke: <ACS_PUBLIC_URL>/api/v1/billing/xendit/webhook dengan token yang sama.
ACS_BILLING_ENABLED=false
ACS_XENDIT_SECRET_KEY=
ACS_XENDIT_CALLBACK_TOKEN=
ACS_XENDIT_BASE_URL=https://api.xendit.co
ACS_BILLING_INVOICE_HOURS=24
