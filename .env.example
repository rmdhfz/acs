# Salin ke .env (atau inject langsung sebagai environment variable di deployment).
# Jangan commit file .env asli.

# DSN sqlx/go-sql-driver/mysql, format: user:pass@tcp(host:port)/dbname?parseTime=true&loc=Local
ACS_DB_DSN=acs:acs@tcp(127.0.0.1:3306)/acs?parseTime=true&loc=Local&charset=utf8mb4

# Alamat listen REST API internal (Echo)
ACS_HTTP_ADDR=:8080

# Alamat listen endpoint CWMP (dipisah dari REST agar bisa di-expose/di-rate-limit berbeda)
ACS_CWMP_ADDR=:7547

# Secret untuk signing JWT sesi user (>= 32 karakter)
ACS_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
ACS_JWT_EXPIRY=8h

# Key AES-256 (32 byte, base64) untuk enkripsi kredensial connection request / inform auth.
# Generate mis. dengan: openssl rand -base64 32
ACS_CREDENTIAL_ENC_KEY=CHANGE_ME_BASE64_32_BYTE_KEY================

# Berapa lama HTTP request CWMP dianggap idle/selesai menunggu request lanjutan dari CPE
ACS_SESSION_IDLE_TIMEOUT=30s

# Object storage firmware, S3-compatible (ROADMAP.md Fase 2 — MinIO untuk dev).
# Endpoint & kredensial WAJIB diisi eksplisit, tidak ada default hardcoded.
# Strategi delivery ke CPE: presigned GET URL LANGSUNG dari object storage ini
# (bukan proxy lewat ACS) — endpoint harus reachable dari jaringan CPE fisik
# di deployment nyata, bukan cuma dari ACS/dashboard.
ACS_MINIO_ENDPOINT=127.0.0.1:19000
ACS_MINIO_ACCESS_KEY=change-me-minio-access-key
ACS_MINIO_SECRET_KEY=change-me-minio-secret-key-min-8-char
ACS_MINIO_BUCKET=acs-firmware
ACS_MINIO_USE_SSL=false
