# Reverse proxy TLS siap pakai untuk ACS (overlay docker-compose.tls.yml).
# Caddy memperoleh & memperbarui sertifikat Let's Encrypt otomatis untuk ACS_DOMAIN
# (DNS A/AAAA ke server ini + port 80/443 terbuka dari internet).
#
# Alamat ACS yang dipasang di CPE:  https://<ACS_DOMAIN>/cwmp
# Alamat Console web:               https://<ACS_DOMAIN>/
{
	# Email Let's Encrypt (pemberitahuan kedaluwarsa sertifikat) — WAJIB diisi.
	email {$ACS_TLS_EMAIL}
}

{$ACS_DOMAIN} {
	encode zstd gzip

	# Console web (hasil `npm run build` di-mount ke /srv/console). Rute SPA jatuh ke index.html.
	# /metrics (Prometheus) TIDAK publik: tanpa auth by design (konvensi exporter), memuat jumlah perangkat/antrean/sesi.
	# Prometheus menyadap acsd langsung di jaringan internal compose (acsd:8080), bukan lewat proxy publik.
	handle /api/v1/metrics {
		respond "Not Found" 404
	}

	handle /api/* {
		# WebSocket (/api/v1/ws) otomatis di-upgrade oleh reverse_proxy.
		reverse_proxy acsd:8080
	}

	# Trafik TR-069 dari CPE. Tanpa buffering: sesi CWMP stateful & berurutan.
	handle /cwmp* {
		reverse_proxy acsd:7547 {
			flush_interval -1
			transport http {
				read_timeout 10m
			}
		}
	}

	# Probe kesehatan publik (read-only) — dipakai monitoring eksternal/uptime checker.
	handle /healthz {
		reverse_proxy acsd:8080
	}
	handle /readyz {
		reverse_proxy acsd:8080
	}

	# Aset ber-hash: tidak ada = 404 sungguhan (bukan HTML SPA yang menyesatkan), cache panjang.
	handle /assets/* {
		root * /srv/console
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/console
		try_files {path} /index.html
		header Cache-Control "no-cache"
		# CSP SPA: token sesi ada di localStorage, jadi XSS apa pun = pencurian sesi; skrip hanya dari origin sendiri
		# (tanpa 'unsafe-inline'). style 'unsafe-inline' dibutuhkan atribut style React/Recharts; gambar https: untuk
		# logo tenant & tile peta OSM; font Google Fonts. API & WebSocket satu origin ('self').
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}
