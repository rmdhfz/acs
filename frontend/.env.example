# Variabel build Console web (disalin ke frontend/.env.production atau diberikan saat `npm run build`).
# Semua berawalan VITE_ dan ikut ter-bundle ke klien — JANGAN isi rahasia.

# Alamat REST API yang dipanggil browser (lihat backend ACS_HTTP_ADDR). Untuk deployment isi alamat server, mis. http://acs.contoh.id:18080/api/v1
VITE_API_BASE_URL=http://localhost:18080/api/v1

# URL publik situs (tanpa slash akhir): dipakai canonical, Open Graph, sitemap.xml, JSON-LD beranda.
VITE_SITE_URL=https://acs.contoh.id

# Email kontak untuk tombol "Minta demo" di beranda (kosong = tombol disembunyikan).
VITE_CONTACT_EMAIL=

# (tombol SSO kini otomatis: tampil bila backend OIDC terkonfigurasi — tidak perlu variabel build)
